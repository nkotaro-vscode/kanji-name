# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Public site URL (Vercel production domain, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Search Console — HTML tag verification code only (not the full meta tag)
GOOGLE_SITE_VERIFICATION=your-verification-code

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=xxxxxxxxxx

# Printful / SUZURI / shop product URL (use # until ready)
NEXT_PUBLIC_MERCH_SHOP_URL=#
